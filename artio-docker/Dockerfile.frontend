FROM node:24-alpine AS build
ARG MODULE
ARG APP_NAME
WORKDIR /workspace
COPY ${MODULE}/package.json ${MODULE}/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY ${MODULE}/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY artio-docker/nginx.conf /etc/nginx/conf.d/default.conf
ARG MODULE
ARG APP_NAME
COPY --from=build /workspace/dist/${APP_NAME}/browser /usr/share/nginx/html
EXPOSE 80
