FROM node:24.22.0-alpine3.23@sha256:e44c87c7dd212720eb00469aeac89504ca2be77b8f0d6dbffb30665d5fcc59e1 AS build
ARG MODULE
ARG APP_NAME
WORKDIR /workspace
COPY ${MODULE}/.npmrc ${MODULE}/package.json ${MODULE}/package-lock.json ./
RUN npm install --global npm@12.2.0 && npm ci --no-audit --no-fund
COPY ${MODULE}/ ./
RUN npm run build

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
RUN apk upgrade --no-cache
COPY artio-docker/nginx.conf /etc/nginx/conf.d/default.conf
ARG MODULE
ARG APP_NAME
COPY --from=build /workspace/dist/${APP_NAME}/browser /usr/share/nginx/html
EXPOSE 80
