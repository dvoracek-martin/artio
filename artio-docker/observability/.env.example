# Pass as the second Compose env file when enabling the observability add-on.
# Replace with a unique value before exposing the service beyond localhost.
ARTIO_OBSERVABILITY_ADMIN_USER=admin
ARTIO_OBSERVABILITY_ADMIN_PASSWORD=replace-with-a-unique-password
ARTIO_OBSERVABILITY_TRACES_ENABLED=true
ARTIO_OBSERVABILITY_METRICS_ENABLED=true
