# Optional Compose overrides. Core installation credentials are generated on first start and kept in a Docker volume.
# Fill these only when you deliberately want to supply your own initial installation secrets.
ARTIO_DATABASE_USERNAME=artio
ARTIO_DATABASE_PASSWORD=
ARTIO_JWT_SECRET=
ARTIO_ENCRYPTION_KEY=
# Required only when enabling the optional search profile.
ARTIO_OPENSEARCH_INITIAL_ADMIN_PASSWORD=
ARTIO_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
ARTIO_EXTENSION_TRUSTED_REGISTRIES=
ARTIO_EXTENSION_DOCKER_ENABLED=false
ARTIO_INVENTORY_RESERVATION_TTL=PT30M
ARTIO_INVENTORY_EXPIRY_INTERVAL_MS=60000
ARTIO_SETUP_TOKEN=
ARTIO_STRIPE_SECRET_KEY=
ARTIO_STRIPE_WEBHOOK_SECRET=
ARTIO_SMTP_HOST=
ARTIO_SMTP_PORT=587
ARTIO_SMTP_USERNAME=
ARTIO_SMTP_PASSWORD=
ARTIO_EMAIL_ENABLED=false
ARTIO_EMAIL_POLL_INTERVAL_MS=30000
