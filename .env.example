# Copy to .env for local Compose development. Replace every placeholder before deployment.
ARTIO_JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-development
ARTIO_ENCRYPTION_KEY=replace-with-a-different-32-byte-or-longer-secret
ARTIO_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
ARTIO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ARTIO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-unique-password-of-at-least-16-characters
ARTIO_STRIPE_SECRET_KEY=
ARTIO_STRIPE_WEBHOOK_SECRET=
ARTIO_SMTP_HOST=
ARTIO_SMTP_PORT=587
ARTIO_SMTP_USERNAME=
ARTIO_SMTP_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-unique-local-password
