# Optional Compose overrides. Core installation credentials are generated on first start and kept in a Docker volume.
# Fill these only when you deliberately want to supply your own initial installation secrets.
ARTIO_DATABASE_USERNAME=artio
ARTIO_DATABASE_PASSWORD=
ARTIO_JWT_SECRET=
ARTIO_ENCRYPTION_KEY=
# Temporary rotation keyring path inside the protected installation secret volume (leave blank normally).
ARTIO_ENCRYPTION_KEYRING_FILE=
ARTIO_SEARCH_ENABLED=false
ARTIO_SEARCH_PROVIDER=extension
ARTIO_SEARCH_EXTENSION_PLUGIN_ID=catalog.opensearch
ARTIO_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
ARTIO_BACKOFFICE_URL=http://localhost:4201
ARTIO_STOREFRONT_URL=http://localhost:4200
ARTIO_EXTENSION_TRUSTED_REGISTRIES=
# Optional public Artio Marketplace API base URL, for example http://host.docker.internal:18080
ARTIO_MARKETPLACE_BASE_URL=
ARTIO_MARKETPLACE_ADVISORY_TRUSTED_KEYS=
ARTIO_EXTENSION_DOCKER_ENABLED=true
ARTIO_EXTENSION_CONTROLLER_TOKEN=
ARTIO_INVENTORY_RESERVATION_TTL=PT30M
ARTIO_INVENTORY_EXPIRY_INTERVAL_MS=60000
ARTIO_SETUP_TOKEN=
ARTIO_PAYMENT_PROVIDER=none
ARTIO_PAYMENTS_EXTENSION_PLUGIN_ID=
ARTIO_SHIPPING_PROVIDER=static
ARTIO_SHIPPING_EXTENSION_PLUGIN_ID=shipping.swiss-post
ARTIO_CHECKOUT_SHIPPING_COST=0.00
ARTIO_EMAIL_ENABLED=false
ARTIO_EMAIL_PROVIDER=none
ARTIO_NOTIFICATIONS_EXTENSION_PLUGIN_ID=
ARTIO_EMAIL_POLL_INTERVAL_MS=30000
